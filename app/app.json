{
  "expo": {
    "name": "Bowser",
    "slug": "fuel-forecast",
    "version": "0.6.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fuelforecast",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.nathann2997.fuelforecast",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#16191C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nathann2997.fuelforecast"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FFB22E"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#16191C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 110
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is used only on your phone to sort nearby fuel stations by distance.",
          "locationAlwaysAndWhenInUsePermission": "Bowser's widget uses your location on your phone to list the stations nearest to you. It never leaves your phone.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "BowserSmall",
              "label": "Bowser",
              "description": "Today's fill-up call for your fuel and when prices are likely to rise.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 14400000
            },
            {
              "name": "BowserMedium",
              "label": "Bowser",
              "description": "The fill-up call plus your pinned, nearest or cheapest stations, with 7-day price forecasts.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 14400000
            }
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# react-native-android-widget runs widget updates through WorkManager. R8 full mode (AGP 9) strips the\n# no-arg constructors WorkManager/Room create by reflection, which crashes release builds on launch\n# (github.com/sAleksovski/react-native-android-widget/issues/159). Keep them.\n-keep class androidx.work.impl.WorkDatabase_Impl { <init>(); }\n-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class * extends androidx.work.InputMerger { <init>(); }\n-keep class * extends androidx.work.ListenableWorker { <init>(android.content.Context, androidx.work.WorkerParameters); }\n-keep class com.reactnativeandroidwidget.** { *; }",
            "enableMinifyInReleaseBuilds": false
          }
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "BowserWidget",
              "displayName": "Bowser",
              "description": "Today's fill-up call, when prices are likely to rise, and your cheapest nearby or pinned stations.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              },
              "android": null
            }
          ]
        }
      ],
      "expo-background-task",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "29af590d-9a65-4d5c-a3fd-f8e1a7d34f5b"
      }
    },
    "owner": "nathann97",
    "updates": {
      "url": "https://u.expo.dev/29af590d-9a65-4d5c-a3fd-f8e1a7d34f5b"
    }
  }
}
