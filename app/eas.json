{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview",
      "uploadSourceMaps": true,
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "channel": "production",
      "uploadSourceMaps": true,
      "autoIncrement": true
    },
    "simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    }
  }
}
